# GSC-MCP — Umgebungskonfiguration ([docs/01], [docs/08]).
# Kopieren nach .env und ausfüllen. .env gehört NICHT ins Repository.

# ── Server ────────────────────────────────────────────────────────────────
# Öffentliche Basis-URL (ohne abschließenden Schrägstrich).
ISSUER=https://gsc2mcp.drossmedia.de
PORT=8080

# ── Datenbank ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://gscmcp:CHANGE_ME@localhost:5432/gscmcp
# Nur für docker-compose (Passwort des Postgres-Containers):
POSTGRES_PASSWORD=CHANGE_ME

# ── Verschlüsselung ───────────────────────────────────────────────────────
# 32-Byte-Schlüssel (AES-256) für den Google-Refresh-Token.
# Erzeugen mit:  openssl rand -base64 32
ENCRYPTION_KEY=

# ── Google OAuth (GCP-Client, sensitiver Scope webmasters.readonly) ───────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — Vorgaben werden aus ISSUER abgeleitet:
# GOOGLE_REDIRECT_URI=https://gsc2mcp.drossmedia.de/oauth/google/callback
# GOOGLE_SCOPES=openid email https://www.googleapis.com/auth/webmasters.readonly
